# Copiá este archivo a .env SOLO para probar en tu computadora. En producción todo va en GitHub Secrets.
NOTION_TOKEN=ntn_xxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

META_PAGE_ID=1234567890
META_PAGE_TOKEN=EAAB...
IG_USER_ID=17841400000000000

MEDIA_REPO=usuario/pi-media
MEDIA_REPO_TOKEN=github_pat_xxx
# MEDIA_BRANCH=main
# MEDIA_URL_BASE=https://usuario.github.io/pi-media   # solo si activás GitHub Pages en pi-media

# X (opcional: dejar vacío si no se usa)
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Comportamiento
TIMEZONE=America/Asuncion
MAX_DELAY_HOURS=48
TOKEN_WARN_DAYS=7
DRY_RUN=1
